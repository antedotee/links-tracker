/**
 * Workers.dev only: no custom `routes`.
 * Public app: https://user-application-stage.kartikyadavstand.workers.dev (staging)
 *            https://user-application-production.kartikyadavstand.workers.dev (production)
 *
 * Replace D1 database_id values with the same IDs as in apps/data-service/wrangler.jsonc per env.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/trpc/*", "/click-socket", "/r/*"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "name": "user-application-stage",
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "e069c262-3ec5-4f3e-bf02-42ddf2937eed",
          "remote": true
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "remote": true
        }
      ]
    },
    "production": {
      "name": "user-application-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "416efea9-c0c4-4e27-8961-ca0e0a8483a9"
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production"
        }
      ]
    }
  }
}
