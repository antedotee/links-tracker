# Copy to apps/user-application/.env
#
# VITE_* is embedded at build time. Rebuild after changing this file.
#
# Staging (workers.dev) — matches wrangler env.stage name user-application-stage:
VITE_BASE_HOST=user-application-stage.kartikyadavstand.workers.dev
#
# Production build:
# VITE_BASE_HOST=user-application-production.kartikyadavstand.workers.dev
#
# Local dev with pnpm dev:
# VITE_BASE_HOST=localhost:3000
