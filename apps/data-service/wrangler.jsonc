/**
 * Workers.dev only: no custom `routes` — URLs are https://<name>.<subdomain>.workers.dev
 *
 * Before deploy, replace placeholder IDs and names with resources from your account:
 *   wrangler d1 create links-tracker-stage
 *   wrangler d1 create links-tracker-production
 *   wrangler kv namespace create links-tracker-cache-stage
 *   wrangler kv namespace create links-tracker-cache-production
 *   wrangler queues create links-tracker-queue-stage
 *   wrangler queues create links-tracker-dead-letter-queue-stage
 *   wrangler queues create links-tracker-queue-production
 *   wrangler queues create links-tracker-dead-letter-queue-production
 *   wrangler r2 bucket create links-tracker-eval-stage
 *   wrangler r2 bucket create links-tracker-eval-production
 *
 * Paste the same stage D1 database_id into apps/user-application wrangler env.stage.
 * Paste the same production D1 id into user-application env.production.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"stage": {
			"name": "data-service-stage",
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "e069c262-3ec5-4f3e-bf02-42ddf2937eed",
					"remote": true
				}
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "e527e879b7c64b27a3bf12373695c8d1",
					"remote": true
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "links-tracker-queue-stage",
						"dead_letter_queue": "links-tracker-dead-letter-queue-stage"
					},
					{
						"queue": "links-tracker-dead-letter-queue-stage",
						"retry_delay": 0
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "links-tracker-queue-stage"
					}
				]
			},
			"workflows": [
				{
					"binding": "DESTINATION_EVALUATION",
					"name": "destination-evaluation",
					"class_name": "DestinationEvaluationWorkflow"
				}
			],
			"browser": {
				"binding": "VIRTUAL_BROWSER"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "links-tracker-eval-stage"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "EVALUATION_SCHEDULER",
						"class_name": "EvaluationScheduler"
					},
					{
						"class_name": "LinkClickTracker",
						"name": "LINK_CLICK_TRACKER"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"EvaluationScheduler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"LinkClickTracker"
					]
				}
			]
		},
		"production": {
			"name": "data-service-production",
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "416efea9-c0c4-4e27-8961-ca0e0a8483a"
				}
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "9fa31f1a69f4498a865524aefdbc3408"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "links-tracker-queue-production",
						"dead_letter_queue": "links-tracker-dead-letter-queue-production"
					},
					{
						"queue": "links-tracker-dead-letter-queue-production",
						"retry_delay": 0
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "links-tracker-queue-production"
					}
				]
			},
			"workflows": [
				{
					"binding": "DESTINATION_EVALUATION",
					"name": "destination-evaluation-production",
					"class_name": "DestinationEvaluationWorkflow"
				}
			],
			"browser": {
				"binding": "VIRTUAL_BROWSER"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "links-tracker-eval-production"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "EVALUATION_SCHEDULER",
						"class_name": "EvaluationScheduler"
					},
					{
						"class_name": "LinkClickTracker",
						"name": "LINK_CLICK_TRACKER"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"EvaluationScheduler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"LinkClickTracker"
					]
				}
			]
		}
	}
}